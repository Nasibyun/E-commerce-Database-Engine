# Environment variables for the ecommerce-dba project.
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# --- Primary database ---
POSTGRES_DB=ecommerce_dba
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Replica ---
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicator_pw
REPLICA_PORT=5433

# --- pgAdmin (optional web UI) ---
PGADMIN_EMAIL=admin@ecommerce.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=8080

# --- Data generation ---
DATA_CUSTOMERS=50000
DATA_PRODUCTS=2000
DATA_ORDERS=600000
